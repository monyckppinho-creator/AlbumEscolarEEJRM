<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Álbum Escolar EEJRM</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 20px;
      background-color: #f4f6f8;
      text-align: center;
    }
    .upload-card {
      background: #ffffff;
      padding: 20px;
      border-radius: 12px;
      max-width: 450px;
      margin: 0 auto 30px auto;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    input[type="file"] {
      margin: 15px 0;
    }
    button {
      background-color: #007bff;
      color: white;
      border: none;
      padding: 12px 24px;
      font-size: 16px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover {
      background-color: #0056b3;
    }
    #galeria {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px;
    }
    .foto-item {
      background: #ffffff;
      padding: 8px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    .foto-item img {
      max-width: 280px;
      max-height: 280px;
      object-fit: cover;
      border-radius: 6px;
      display: block;
    }
  </style>
</head>
<body>

  <div class="upload-card">
    <h2>Álbum Escolar EEJRM</h2>
    <p>Espaço digital colaborativo para armazenar e compartilhar as melhores memórias da nossa escola.</p>
    <input type="file" id="fotoInput" accept="image/*"><br>
    <button onclick="enviarFotoDoTelemovel()">Enviar Foto</button>
    <p id="statusEnvio" style="color: #007bff; font-weight: bold; margin-top: 10px;"></p>
  </div>

  <h3>Memórias da Escola</h3>
  <div id="galeria"></div>

  <!-- SDKs do Firebase -->
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

  <script>
    // 1. b9b5ce4729a968073ab3675ba66f58f3:
    const IMGBB_API_KEY = "b9b5ce4729a968073ab3675ba66f58f3";

    // 2. b9b5ce4729a968073ab3675ba66f58f3:
    const firebaseConfig = {
      apiKey: "b9b5ce4729a968073ab3675ba66f58f3",
      authDomain: "SEU_PROJETO.firebaseapp.com",
      projectId: "SEU_PROJETO",
      storageBucket: "SEU_PROJETO.appspot.com",
      messagingSenderId: "123456789",
      appId: "1:123456789:web:abcdef"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();

    async function enviarFotoDoTelemovel() {
      const fileInput = document.getElementById('fotoInput');
      const statusText = document.getElementById('statusEnvio');
      const file = fileInput.files[0];

      if (!file) {
        alert("Por favor, selecione uma foto!");
        return;
      }

      statusText.innerText = "A enviar foto...";

      try {
        const formData = new FormData();
        formData.append("image", file);

        const response = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, {
          method: "POST",
          body: formData
        });

        const result = await response.json();

        if (result.success) {
          const urlPublica = result.data.url;

          await db.collection('postagens').add({
            url: urlPublica,
            criadoEm: firebase.firestore.FieldValue.serverTimestamp()
          });

          statusText.innerText = "Foto enviada com sucesso!";
          fileInput.value = "";
        } else {
          alert("Erro ao enviar a imagem. Verifique a chave do ImgBB.");
          statusText.innerText = "";
        }
      } catch (error) {
        console.error(error);
        alert("Falha no envio da foto.");
        statusText.innerText = "";
      }
    }

    // Exibir fotos em tempo real para todos os usuários
    db.collection('postagens').orderBy('criadoEm', 'desc')
      .onSnapshot((snapshot) => {
        const galeria = document.getElementById('galeria');
        galeria.innerHTML = '';
        snapshot.forEach((doc) => {
          const data = doc.data();
          if (data.url) {
            galeria.innerHTML += `
              <div class="foto-item">
                <img src="${data.url}" alt="Foto do Álbum">
              </div>`;
          }
        });
      });
  </script>

</body>
</html>
